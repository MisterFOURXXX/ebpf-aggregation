# ---------- build stage ----------
FROM golang:1.21 AS builder
WORKDIR /workspace

# Copy the module definition first for better layer caching.
# go.sum is not committed, so it will be generated by `go mod tidy`.
COPY go.mod ./

# Copy the entire source tree before running tidy — tidy needs the
# import graph, and the import graph comes from the source files.
COPY . .

# Generate go.sum and resolve any missing indirect dependencies.
RUN go mod tidy

# Build a statically-linked binary for the build host's architecture.
# Do NOT hard-code GOARCH: the VM is ARM64 (Oracle Ampere) and the
# KIND node runs on the same machine.
RUN CGO_ENABLED=0 GOOS=linux \
    go build -a -trimpath -o manager main.go

# ---------- runtime stage ----------
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/manager .
USER 65532:65532
ENTRYPOINT ["/manager"]